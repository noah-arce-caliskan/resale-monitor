# Copy this file to .env when the application skeleton is created.
# Keep all values blank or demonstrative in this committed file.

APP_ENV=development
LOG_LEVEL=INFO
DATA_DIR=./data/local
DATABASE_URL=sqlite:///./data/local/resale-monitor.sqlite3

# eBay official API. Never commit real credentials.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US

# AI provider credentials. Keep unused providers blank and remove them when the
# provider strategy is selected.
OPENAI_API_KEY=
